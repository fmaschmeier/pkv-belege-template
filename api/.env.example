# Supabase
SUPABASE_URL=https://your-project.supabase.co
# Service-Role-/Secret-Key: die API greift damit an RLS vorbei zu und prüft Benutzer selbst über das JWT
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# Publishable/Anon-Key, Rückfall falls kein Service-Key gesetzt ist
SUPABASE_KEY=your-supabase-publishable-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Service-to-Service-Aufrufe
API_SECRET_KEY=your-api-secret-for-service-calls

# PDF-Extraktion (Leistungsabrechnungen)
PDFCO_API_KEY=your-pdfco-api-key

# Claude (Neu-Auslesen von Belegen in der Web-App)
ANTHROPIC_CLAUDE_API_KEY=your-anthropic-api-key
ANTHROPIC_CLAUDE_MODEL=claude-sonnet-4-20250514

# Erlaubte Web-Adressen (JSON-Liste)
CORS_ORIGINS=["http://localhost:5173","https://your-web-app.run.app"]

# Vornamen der versicherten Personen, wie sie in Dateinamen vorkommen
INSURED_PERSONS=Jonas,Miriam,Mila,Ben,Helga
