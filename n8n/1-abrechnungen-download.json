      "parameters": {
        "jsCode": "// 1) Workflow-Static-Data laden (global)\nconst staticData = $getWorkflowStaticData('global');\n\nstaticData.current_universa_session = $input.first().json.session_id;\nstaticData.current_universa_session_time = $now;\nstaticData.current_universa_session_time_unix = Date.now();\n\n// 2) Mindestens ein Item zurückgeben\nreturn [\n  {\n    json: {\n      session_id: staticData.current_universa_session,\n      stored_at: staticData.current_universa_session_time,\n      stored_at_unix: staticData.current_universa_session_time_unix,\n    },\n  },\n];"
