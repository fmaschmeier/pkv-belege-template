    {
      "id": "78d35cac-c5e3-4739-b7ee-de66344976b2",
      "name": "Get session from global",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -48,
        -96
      ],
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\n\nconst MAX_AGE_MS = 5 * 60 * 1000;\nconst now = Date.now();\n\nconst storedSessionId = staticData.current_universa_session ?? null;\nconst storedAt = staticData.current_universa_session_time_unix ?? null;\n\nconst ageMs = storedAt ? now - storedAt : null;\nconst reusable = Boolean(storedSessionId && storedAt && ageMs <= MAX_AGE_MS);\n\nreturn [\n  {\n    json: {\n      reusable,\n\n      // business output\n      session_id: reusable ? storedSessionId : null,\n\n      // debug: always show what is stored\n      stored_session_id: storedSessionId,\n      last_session_time_unix: storedAt,\n      last_session_age_ms: ageMs,\n      now_unix: now,\n      max_age_ms: MAX_AGE_MS,\n    },\n  },\n];"
      }
    },
    {
      "id": "b7c51ef7-445d-4039-9215-f1e7aa87b9c0",
      "name": "Code in JavaScript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        -160
      ],
      "parameters": {
        "jsCode": "const fromStored = $input.first().json.stored_session_id ?? null;\n\nlet fromNew = null;\ntry {\n  fromNew = $('save session to global').first().json.session_id ?? null;\n} catch (e) {\n  fromNew = null;\n}\n\nif (!fromStored && !fromNew) {\n  throw new Error('No session_id available: neither reused nor newly created');\n}\n\nreturn [\n  {\n    json: {\n      session_id: fromStored || fromNew,\n      source: fromStored ? 'reused' : 'new',\n    },\n  },\n];"
      }
    },
    {
      "id": "41023058-b6da-458a-9f95-3009a9de0667",
      "name": "extract files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "alwaysOutputData": true,
      "position": [
        2928,
        -336
      ],
      "parameters": {
        "jsCode": "const docs = $input.first().json.documents;\n\nif (!Array.isArray(docs) || docs.length === 0) {\n  throw new Error('documents is missing or empty');\n}\n\nreturn docs.map((doc) => {\n  if (!doc.filename || !doc.content_base64) {\n    throw new Error('Document missing filename or content_base64');\n  }\n\n  const base64 = String(doc.content_base64).replace(/^data:.*?;base64,/, '');\n\n  return {\n    json: {\n      filename: doc.filename,\n      date: doc.date ?? null,\n    },\n    binary: {\n      data: {\n        data: base64,\n        fileName: doc.filename,\n        mimeType: 'application/pdf',\n      },\n    },\n  };\n});"
      }
    },
